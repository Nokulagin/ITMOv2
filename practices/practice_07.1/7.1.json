    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/schemas/pr-review.json\",\n  \"title\": \"PRReview\",\n  \"description\": \"Structured code review output. Each comment is anchored to a specific line of a file in the PR diff.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"summary\", \"comments\"],\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"Overall review body rendered above the inline comments. Markdown allowed.\",\n      \"minLength\": 1,\n      \"maxLength\": 65536\n    },\n    \"comments\": {\n      \"type\": \"array\",\n      \"description\": \"Inline comments, one per issue found.\",\n      \"minItems\": 0,\n      \"maxItems\": 50,\n      \"items\": { \"$ref\": \"#/$defs/LineComment\" }\n    }\n  },\n  \"$defs\": {\n    \"LineComment\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"path\", \"line\", \"side\", \"body\"],\n      \"properties\": {\n        \"path\": {\n          \"type\": \"string\",\n          \"description\": \"Repository-relative file path exactly as it appears in the PR files list, e.g. 'src/app/main.ts'. No leading slash.\",\n          \"minLength\": 1,\n          \"pattern\": \"^[^/\\\\\\\\].*[^/\\\\\\\\]$|^[^/\\\\\\\\]$\"\n        },\n        \"line\": {\n          \"type\": \"integer\",\n          \"description\": \"Absolute line number in the file (new version for RIGHT, old version for LEFT). Must fall inside a hunk shown in the diff.\",\n          \"minimum\": 1\n        },\n        \"side\": {\n          \"type\": \"string\",\n          \"description\": \"RIGHT = new file (added or context lines). LEFT = old file (deleted lines).\",\n          \"enum\": [\"RIGHT\", \"LEFT\"]\n        },\n        \"start_line\": {\n          \"type\": \"integer\",\n          \"description\": \"First line of a multi-line comment. Must be less than 'line'. Omit for single-line comments.\",\n          \"minimum\": 1\n        },\n        \"start_side\": {\n          \"type\": \"string\",\n          \"description\": \"Required when start_line is present. Usually equal to 'side'.\",\n          \"enum\": [\"RIGHT\", \"LEFT\"]\n        },\n        \"body\": {\n          \"type\": \"string\",\n          \"description\": \"Comment text in Markdown. Be specific and actionable.\",\n          \"minLength\": 1,\n          \"maxLength\": 65536\n        }\n      },\n      \"allOf\": [\n        {\n          \"if\": { \"required\": [\"start_line\"] },\n          \"then\": { \"required\": [\"start_side\"] }\n        },\n        {\n          \"if\": { \"required\": [\"start_side\"] },\n          \"then\": { \"required\": [\"start_line\"] }\n        }\n      ]\n    }\n  }\n}"
      },
